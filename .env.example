# Signora configuration. Copy to .env and fill in. Never commit .env.

# --- App ---
APP_ENV=development                      # development | production
PUBLIC_BASE_URL=https://hemanth.tail50655e.ts.net
SECRET_KEY=                              # 64+ random chars: python3 -c "import secrets;print(secrets.token_urlsafe(64))"
LOG_LEVEL=INFO                           # DEBUG | INFO | WARNING | ERROR
API_THREADS=20                           # API request threads; the DB pool matches it
API_TRUST_PROXY_HEADERS=false            # true only when the API is reachable solely via Caddy (compose)
# SIGNORA_ROOT=                          # repository root; set by container images, derived otherwise
# SIGNORA_COMMIT=                        # build commit shown by /api/v1/meta; set at image build time

# --- Database ---
# Defaults are for processes on the host (./install.sh, local dev, tests). Each *_PORT is the single
# source for both sides: infra/compose.yaml publishes that port on 127.0.0.1 and the app connects to it.
# Services running inside compose override *_HOST/*_PORT with in-network values (postgres:5432, gotenberg:3000).
POSTGRES_USER=signora
POSTGRES_PASSWORD=                       # random string
POSTGRES_DB=signora
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432

# --- Storage ---
BLOB_STORE_BACKEND=local                 # local (s3 is added with its implementation)
BLOB_STORE_DIR=./data/blobs             # relative paths resolve from the repository root; git-ignored

# --- Document conversion (Gotenberg: no network egress; reached through gotenberg-gateway) ---
GOTENBERG_HOST=127.0.0.1
GOTENBERG_PORT=53000

# --- Documents (uploads) ---
DOCUMENT_MAX_BYTES=52428800             # 50 MB per file (Caddy refuses bodies over 55 MB first)
DOCUMENT_MAX_PAGES=200                  # pages per document (.docx counted after conversion)
DOCUMENT_UPLOADS_PER_HOUR=60            # per person

# --- AI provider (OpenAI-compatible) ---
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-6-luna
AI_REASONING_EFFORT=low                 # field detection: low (fast) or medium (catches more conditions)
AI_TIMEOUT_SECONDS=200                  # one detection call; the slowest seen took 51 s
AI_MAX_OUTPUT_TOKENS=16000              # a cost ceiling per call; the largest answer used 6,000
AI_WHOLE_DOC_MAX_TOKENS=40000

# --- Email (SendGrid API, Gmail SMTP with an app password, or Mailpit in development) ---
EMAIL_PROVIDER=mailpit                   # sendgrid | smtp (Gmail) | mailpit (dev capture, never production)
SENDGRID_API_KEY=                        # SG.... with the Mail Send permission (EMAIL_PROVIDER=sendgrid)
MAILPIT_HOST=127.0.0.1                   # Mailpit SMTP capture (EMAIL_PROVIDER=mailpit); web inbox on :8025
MAILPIT_SMTP_PORT=1025
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=                           # Gmail app password (16 chars)
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Signora
EMAIL_DAILY_LIMIT=450                    # stay under Gmail's ~500 recipients/day

# --- Accounts and sessions (Phase 2) ---
AUTH_SESSION_IDLE_HOURS=12               # sign out after this long without activity
AUTH_SESSION_TOUCH_MINUTES=5             # how often a session's last activity is written
AUTH_SIGNUP_LINK_HOURS=24
AUTH_RESET_LINK_MINUTES=30
AUTH_INVITE_DAYS=7
AUTH_EMAIL_COOLDOWN_SECONDS=60           # per address, for sign-up and reset emails
AUTH_EMAIL_HOURLY_LIMIT=5                # per address, for sign-up and reset emails
AUTH_INVITES_PER_HOUR=50                 # per workspace
AUTH_LOGIN_FREE_ATTEMPTS=5               # wrong passwords before waits start (1 s, doubling)
AUTH_LOGIN_BACKOFF_CAP_MINUTES=15
AUTH_LOGIN_IP_LIMIT=100                  # failed log-ins per IP per window
AUTH_LOGIN_IP_WINDOW_MINUTES=15
AUTH_PASSWORD_MIN_LENGTH=12
RATE_LIMITER_BACKEND=memory              # memory (single API process); redis later
RATE_LIMITER_MAX_KEYS=100000

# --- Stripe Identity (test mode keys only) ---
STRIPE_SECRET_KEY=                       # sk_test_...
STRIPE_WEBHOOK_SECRET=                   # whsec_...

# --- Company logos (optional; logo.dev API, server-side secret key) ---
# Empty: a company shows its name in the header instead of its logo.
LOGO_DEV_SECRET_KEY=                     # sk_...

# --- Signing defaults ---
SIGNING_OTP_TTL_MINUTES=10
SIGNING_OTP_MAX_ATTEMPTS=5
SIGNER_SESSION_MINUTES=30
DEFAULT_REMINDER_INTERVAL_HOURS=24
DEFAULT_MAX_REMINDERS=5
DEFAULT_EXPIRY_DAYS=14

# --- Worker ---
WORKER_CONCURRENCY=8                     # jobs run at once per worker process
